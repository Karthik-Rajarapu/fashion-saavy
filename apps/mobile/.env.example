# Base URL of the Fashion Saavy API, as reachable from the device running the app.
# Copy to .env and adjust for your setup:
#   Android emulator:  http://10.0.2.2:3000
#   iOS simulator:     http://localhost:3000
#   Physical device:   http://<your computer's LAN IP>:3000
# EXPO_PUBLIC_* values are bundled into the app and are public; never put secrets here.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Development-only identity sent as X-Dev-User-Id (the API must run with DEV_AUTH=true).
# Any UUID works; garments belong to it. Replaced by real sign-in later.
EXPO_PUBLIC_DEV_USER_ID=7f1f5b4e-3c2a-4d6e-9b8a-1c2d3e4f5a6b
