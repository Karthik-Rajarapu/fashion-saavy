# Copy to .env for local development.
# Trust the X-Dev-User-Id header as identity until real sign-in exists. Never in production.
DEV_AUTH=true
# Embedded database and locally stored photos live here (gitignored).
DATA_DIR=.data
# Signs upload and photo URLs. Use a long random value; without it, a new one is generated per process.
STORAGE_SIGNING_SECRET=
